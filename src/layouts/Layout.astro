---
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';
import NovabotButton from '../components/NovabotButton';
import { site } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title = 'Novamed Ingeniería S.A.S',
  description = 'Plataforma de gestión de tecnología biomédica: trazabilidad conectada, inventario, hojas de vida, cronogramas y gestión documental para IPS, clínicas y centros veterinarios. Solicita una demostración.',
  canonicalPath = '',
  noindex = false,
} = Astro.props;

const siteUrl = site.url;
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0C466B" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Novamed Ingeniería S.A.S." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}/images/Logo.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/images/Logo.png`} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {import.meta.env.PUBLIC_GA4_ID && import.meta.env.PUBLIC_GA4_ID !== 'G-XXXXXXXXXX' && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA4_ID}`}></script>
        <script is:inline set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${import.meta.env.PUBLIC_GA4_ID}');`} />
      </>
    )}
    {import.meta.env.PUBLIC_CLARITY_ID && import.meta.env.PUBLIC_CLARITY_ID !== 'xxxxxxx' && (
      <script is:inline set:html={`(function(c,l,a,r,i,t,y){
c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
})(window, document, "clarity", "script", "${import.meta.env.PUBLIC_CLARITY_ID}");`} />
    )}

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: 'Novamed Ingeniería S.A.S.',
        description:
          'Plataforma de gestión de tecnología biomédica y servicios de ingeniería biomédica.',
        url: siteUrl,
        telephone: '+573226942370',
        email: 'novamedingenieria@gmail.com',
        sameAs: ['https://www.instagram.com/novamedingenieria'],
        address: {
          '@type': 'PostalAddress',
          addressCountry: 'CO',
          addressLocality: 'Cali',
        },
        areaServed: {
          '@type': 'Country',
          name: 'Colombia',
        },
        makesOffer: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Product',
              name: 'Plataforma de gestión de tecnología biomédica',
              description: 'Inventario, hojas de vida, cronogramas, códigos QR, órdenes de trabajo y cumplimiento normativo.',
              url: `${siteUrl}/plataforma`,
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Mantenimiento de equipos biomédicos',
              description: 'Mantenimiento preventivo, correctivo y predictivo de equipos biomédicos.',
              url: `${siteUrl}/servicios`,
            },
          },
        ],
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: '¿Qué es la plataforma de Novamed Ingeniería?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Es una plataforma para la gestión de tecnología biomédica: centraliza el inventario, las hojas de vida, los cronogramas, la gestión documental y los indicadores de tus equipos, conectando su trazabilidad en un solo lugar.',
            },
          },
          {
            '@type': 'Question',
            name: '¿Qué incluye una demostración?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Un recorrido guiado por la plataforma según las necesidades de tu institución: inventario, trazabilidad, QR, órdenes de trabajo y control documental. Sin compromiso.',
            },
          },
          {
            '@type': 'Question',
            name: '¿Los precios son públicos?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Sí. Puedes revisar todos los planes y sus precios en la página de Planes. No es necesario registrarse para conocerlos.',
            },
          },
          {
            '@type': 'Question',
            name: '¿Cómo accedo a la información de un equipo?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Cada equipo puede contar con un código QR. Al escanearlo accedes a su hoja de vida, reportes, manuales e información relevante desde cualquier dispositivo.',
            },
          },
          {
            '@type': 'Question',
            name: '¿En qué sectores trabaja Novamed Ingeniería?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Principalmente en los sectores salud y veterinario: IPS, clínicas, consultorios, laboratorios, centros veterinarios y profesionales que gestionan tecnología biomédica.',
            },
          },
          {
            '@type': 'Question',
            name: '¿Cómo solicito una demostración?',
            acceptedAnswer: {
              '@type': 'Answer',
              text: 'Usa la agenda en la página de Contacto, escríbenos por WhatsApp al +57 322 694 2370 o al correo novamedingenieria@gmail.com.',
            },
          },
        ],
      })}
    />
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-MMKWRSDC');</script>
  <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MMKWRSDC"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Navbar client:load currentPath={currentPath} />
    <slot />
    <Footer />
    <NovabotButton client:load />
  </body>
</html>

<style is:global>
  @import 'tailwindcss';

  @custom-variant hover (&:hover);

  @theme inline {
    --color-background: hsl(var(--background));
    --color-background-secondary: hsl(var(--background-secondary));
    --color-foreground: hsl(var(--foreground));
    --color-card: hsl(var(--card));
    --color-card-foreground: hsl(var(--card-foreground));
    --color-primary: hsl(var(--primary));
    --color-primary-foreground: hsl(var(--primary-foreground));
    --color-secondary: hsl(var(--secondary));
    --color-secondary-foreground: hsl(var(--secondary-foreground));
    --color-muted: hsl(var(--muted));
    --color-muted-foreground: hsl(var(--muted-foreground));
    --color-border: hsl(var(--border));
    --color-ring: hsl(var(--ring));

     --color-brand-dark: #0c466b;
     --color-brand-deep: #08344f;
     --color-brand-blue: #197b9d;
     --color-brand-light: #2894b0;
     --color-brand-mist: #e8f5f8;
     --color-green: #197b9d;
     --color-green-deep: #0c466b;
     --color-green-soft: #e8f5f8;
     --color-indigo: #6366f1;
     --color-emerald: #10b981;
     --color-alert: #c2472e;
     --color-alert-soft: #fbeae6;
     --color-warn: #c08a1e;
     --color-warn-soft: #fbf1dc;
     --color-graphite: #17232b;
     --color-surface-alt: #f7f8f8;
     --color-surface-muted: #f5f6f7;
     --color-brand-abyss: #062f49;
     --color-instagram: #E1306C;

    --radius-sm: 0.375rem;
    --radius-md: 0.625rem;
    --radius-lg: 0.875rem;
    --radius-xl: 1.125rem;

    --font-sans: 'DM Sans', system-ui, sans-serif;
    --font-heading: 'DM Sans', system-ui, sans-serif;
  }

  :root {
    --background: 0 0% 100%;
    --background-secondary: 0 0% 100%;
    --foreground: 205 55% 16%;

    /* #0C466B */
    --primary: 203 80% 23%;
    --primary-foreground: 0 0% 100%;

    /* #2894B0 */
    --secondary: 192 63% 42%;
    --secondary-foreground: 0 0% 100%;

    --card: 0 0% 100%;
    --card-foreground: 205 55% 16%;

    --muted: 205 30% 95%;
    --muted-foreground: 0 0% 40%;

    --border: 205 20% 89%;
    --ring: 192 63% 42%;

    /* Deep navy for dark sections */
    --ink: 205 68% 13%;

    --radius: 0.875rem;

    --elevation-1: 0 1px 2px rgba(12, 70, 107, 0.06), 0 1px 3px rgba(12, 70, 107, 0.06);
    --elevation-2: 0 6px 16px rgba(12, 70, 107, 0.09), 0 2px 6px rgba(12, 70, 107, 0.07);
    --elevation-3: 0 16px 32px rgba(12, 70, 107, 0.12), 0 4px 10px rgba(12, 70, 107, 0.1);
    --elevation-4: 0 28px 56px rgba(12, 70, 107, 0.16), 0 10px 20px rgba(12, 70, 107, 0.12);
  }

  @layer base {
    html {
      scroll-behavior: smooth;
      scroll-padding-top: 6rem;
    }

    * {
      @apply border-border;
    }

    body {
      @apply bg-background text-foreground font-sans antialiased;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      @apply font-heading font-semibold tracking-[-0.03em];
    }

    ::selection {
      background: hsl(var(--secondary) / 0.25);
      color: hsl(var(--primary));
    }

    *:focus-visible {
      outline: 2px solid hsl(var(--ring));
      outline-offset: 2px;
    }

  @keyframes success-pop {
    0% { transform: scale(0); opacity: 0; }
    50% { transform: scale(1.15); }
    100% { transform: scale(1); opacity: 1; }
  }
  .success-pop {
    animation: success-pop 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
      [style*='animation'] {
        animation: none !important;
      }
      html {
        scroll-behavior: auto;
      }
    }
  }

  button,
  a,
  nav,
  [role='button'] {
    @apply select-none;
  }

  svg[aria-hidden='true'] {
    pointer-events: none;
  }

  /* ---------- Surface helpers (visual variety) ---------- */

  .section-dark {
    position: relative;
    background:
      radial-gradient(70rem 46rem at 82% -12%, hsl(var(--secondary) / 0.3), transparent 55%),
      radial-gradient(52rem 44rem at -12% 110%, hsl(var(--secondary) / 0.15), transparent 55%),
      linear-gradient(180deg, #062f49 0%, #0c466b 50%, #08344f 100%);
    color: hsl(var(--primary-foreground));
  }

  .section-soft {
    background:
      radial-gradient(60rem 40rem at 105% 0%, hsl(var(--secondary) / 0.06), transparent 60%),
      hsl(var(--background));
  }

  .section-tint {
    background:
      radial-gradient(56rem 40rem at -5% 20%, hsl(var(--secondary) / 0.12), transparent 60%),
      radial-gradient(50rem 40rem at 105% 90%, hsl(var(--primary) / 0.06), transparent 60%),
      hsl(var(--accent));
  }

  .page-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    --grid-line: hsl(var(--primary) / 0.10);
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 50px 50px;
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, transparent 30%, black 100%);
    mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, transparent 30%, black 100%);
  }

  .page-grid-green {
    --grid-line: rgb(25 123 157 / 0.10);
  }

  .page-grid-blue {
    --grid-line: rgb(40 148 176 / 0.10);
  }

  .page-grid-mesh {
    position: absolute;
    inset: 0;
    pointer-events: none;
    --grid-line: hsl(var(--primary) / 0.16);
    --grid-line-fine: hsl(var(--primary) / 0.07);
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to right, var(--grid-line-fine) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line-fine) 1px, transparent 1px);
    background-size: 100px 100px, 100px 100px, 20px 20px, 20px 20px;
    -webkit-mask-image: radial-gradient(ellipse 120% 90% at 50% 0%, transparent 25%, black 100%);
    mask-image: radial-gradient(ellipse 120% 90% at 50% 0%, transparent 25%, black 100%);
  }

  .card-elevated-sm {
    box-shadow: var(--elevation-1);
    border: 1px solid hsl(var(--border) / 0.7);
    transition: box-shadow 350ms cubic-bezier(0.22, 1, 0.36, 1), transform 350ms cubic-bezier(0.22, 1, 0.36, 1), border-color 350ms ease;
  }

  .card-elevated-sm:hover {
    box-shadow: var(--elevation-3);
    transform: translateY(-3px) scale(1.01);
    border-color: hsl(var(--secondary) / 0.35);
  }

  .card-elevated-sm:active {
    transform: translateY(-1px) scale(0.995);
    transition-duration: 100ms;
  }

  .card-hover-glow {
    transition: box-shadow 350ms cubic-bezier(0.22, 1, 0.36, 1), transform 350ms cubic-bezier(0.22, 1, 0.36, 1), border-color 350ms ease;
  }

  .card-hover-glow:hover {
    box-shadow: 0 16px 40px rgba(12, 70, 107, 0.16);
    transform: translateY(-4px) scale(1.01);
    border-color: rgba(12, 70, 107, 0.2);
  }

  .card-hover-glow:active {
    transform: translateY(-1px) scale(0.995);
    transition-duration: 100ms;
  }

  .fn-card {
    transition: box-shadow 350ms cubic-bezier(0.22, 1, 0.36, 1), transform 350ms cubic-bezier(0.22, 1, 0.36, 1), border-color 350ms ease;
  }
  .fn-card:hover {
    box-shadow: var(--hover-shadow, 0 16px 40px rgba(12, 70, 107, 0.18));
    border-color: var(--hover-border, rgba(12, 70, 107, 0.2));
    transform: translateY(-3px) scale(1.01);
  }
  .fn-card:active {
    transform: translateY(-1px) scale(0.995);
    transition-duration: 100ms;
  }

  .video-hover {
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .video-hover:hover {
    transform: translateY(-6px) scale(1.015);
    box-shadow: 0 32px 64px rgba(12, 70, 107, 0.28), 0 0 0 1px rgba(40, 148, 176, 0.2);
  }
  .video-hover:active {
    transform: translateY(-2px) scale(1.005);
    transition-duration: 120ms;
  }

  @keyframes novabot-breathe {
    0%, 100% { transform: scale(1); filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3)); }
    50% { transform: scale(1.04); filter: drop-shadow(0 6px 18px rgba(16,185,129,0.35)); }
  }
  .novabot-breathe {
    animation: novabot-breathe 3s ease-in-out infinite;
  }

  @keyframes demo-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 hsl(var(--secondary) / 0.42);
    }
    50% {
      box-shadow: 0 0 0 7px hsl(var(--secondary) / 0);
    }
  }

  .animate-demo-pulse {
    animation: demo-pulse 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes glow-line-pulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  .animate-glow-line {
    animation: glow-line-pulse 3s ease-in-out infinite;
  }

  @keyframes glow-line-slide {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }

  .animate-glow-slide {
    background-size: 200% 100%;
    animation: glow-line-slide 6s linear infinite;
  }

  /* Grain overlay for dark sections */
  .grain-overlay::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 128px 128px;
    z-index: 1;
    mix-blend-mode: overlay;
  }

  /* Fade edges for carousels */
  .carousel-fade-left::before,
  .carousel-fade-right::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    z-index: 2;
    pointer-events: none;
  }
  .carousel-fade-left::before {
    left: 0;
    background: linear-gradient(to right, #f7f8f8, transparent);
  }
  .carousel-fade-right::after {
    right: 0;
    background: linear-gradient(to left, #f7f8f8, transparent);
  }

  /* Section glow separator */
  .glow-separator {
    position: relative;
  }
  .glow-separator::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(40, 148, 176, 0.3), rgba(25, 123, 157, 0.5), rgba(40, 148, 176, 0.3), transparent);
    z-index: 1;
  }

  /* Pricing shimmer */
  @keyframes pricing-shimmer {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }
  .pricing-shimmer {
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.06) 25%, rgba(255,255,255,0.12) 50%, rgba(255,255,255,0.06) 75%, transparent 100%);
    background-size: 200% 100%;
    animation: pricing-shimmer 4s ease-in-out infinite;
  }

  @keyframes dot-pulse {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; }
  }

  .animate-dot-pulse {
    animation: dot-pulse 2.5s ease-in-out infinite;
  }

  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  .animate-shimmer {
    background-size: 200% 100%;
    animation: shimmer 3s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-demo-pulse,
    .animate-glow-line,
    .animate-glow-slide,
    .animate-dot-pulse,
    .animate-shimmer,
    .novabot-breathe,
    .success-pop,
    .pricing-shimmer {
      animation: none !important;
    }
    .video-hover:hover {
      transform: none;
    }
  }
</style>
